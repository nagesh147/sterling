exports[`PaperResearchTab red bars > matches snapshot with red health column 1`] = `"<table style="width: 100%; font-size: 12px; border-collapse: collapse;"><thead><tr style="color: var(--text-dim); font-size: 11px; letter-spacing: 0.08em;"><th style="text-align: left; padding: 4px 8px;">SYMBOL</th><th style="text-align: left; padding: 4px 8px;">SLEEVE</th><th style="text-align: left; padding: 4px 8px;">DIR</th><th style="text-align: left; padding: 4px 8px;">ENTRY</th><th style="text-align: left; padding: 4px 8px;">SL</th><th style="text-align: left; padding: 4px 8px;">TP</th><th style="text-align: left; padding: 4px 8px;">EXIT</th><th style="text-align: left; padding: 4px 8px;">REDS</th><th style="text-align: left; padding: 4px 8px;">UNREAL</th></tr></thead><tbody><tr style="border-top: 1px solid var(--border);"><td style="padding: 4px 8px;">TEST</td><td style="padding: 4px 8px;">swing</td><td style="padding: 4px 8px; color: var(--k-green-500);">long</td><td style="padding: 4px 8px;">$100</td><td style="padding: 4px 8px;">$95</td><td style="padding: 4px 8px;">$110</td><td style="padding: 4px 8px;">two_red</td><td style="padding: 4px 8px;">1/2<div style="width: 40px; height: 3px; background: rgb(34, 34, 34); margin-top: 1px;"><div style="width: 50%; height: 100%; background: rgb(68, 170, 68);"></div></div></td><td style="padding: 4px 8px; color: var(--k-green-500);">500.00%</td></tr></tbody></table>"`;
